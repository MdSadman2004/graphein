/*
  # 🛡️ Sentinel: Security Headers
  # These headers add defense-in-depth protection for the frontend application.

  # Prevent clickjacking attacks by forbidding iframe embedding
  X-Frame-Options: DENY

  # Prevent MIME-sniffing vulnerabilities
  X-Content-Type-Options: nosniff

  # Enable browser XSS filtering
  X-XSS-Protection: 1; mode=block

  # Protect referrer information
  Referrer-Policy: strict-origin-when-cross-origin

  # Enforce HTTPS connections
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Restrict sources for content to mitigate XSS and data injection
  Content-Security-Policy: default-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; script-src 'self'
